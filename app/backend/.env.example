DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

# Set USE_SQLITE=1 for a zero-setup local run without MySQL installed.
USE_SQLITE=0
DB_NAME=thinkturf
DB_USER=thinkturf
DB_PASSWORD=thinkturf
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173
